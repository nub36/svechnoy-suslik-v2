# --- Database ---
DATABASE_URL=postgresql://suslik:suslik@127.0.0.1:5432/svechnoy_suslik_v2
DB_POOL_MAX=10

# --- Trading mode ---
# DRY_RUN or FORWARD_TEST only. LIVE is locked and will throw at startup.
TRADING_MODE=FORWARD_TEST

# --- Binance (Spot USDT only) ---
BINANCE_BASE_URL=https://api.binance.com
BINANCE_TIMEOUT_MS=15000
# Set true to serve recorded fixtures instead of the network.
BINANCE_OFFLINE=false
# FIXTURES_DIR=/root/svechnoy-suslik-v2/fixtures

# --- Web ---
PORT=3000
NODE_ENV=production

# Secure flag for the admin session cookie. This describes the TRANSPORT the
# app is actually reached over, NOT the build type.
#
#   COOKIE_SECURE=false  -> ONLY for a direct HTTP deployment, e.g. reaching
#                           the app at http://<ip>:3000 with no TLS in front.
#                           Required there: a Secure cookie is not sent back
#                           over HTTP, so the Admin UI would log itself out
#                           about a second after a successful login.
#   COOKIE_SECURE=true   -> Use whenever the app is served over HTTPS
#                           (directly or behind a TLS-terminating proxy).
#
# If unset, it falls back to NODE_ENV === 'production', which is the
# security-conscious default. X-Forwarded-Proto is deliberately NOT trusted:
# there is no trusted-proxy model in this deployment.
#
# The current VPS is reached over plain http://89.125.24.50:3000 and therefore
# needs COOKIE_SECURE=false. Switch to true once TLS is in front of it.
COOKIE_SECURE=false

# --- Worker loop intervals (ms) ---
MARKET_LOOP_MS=15000
STRATEGY_LOOP_MS=20000
OUTCOME_LOOP_MS=20000

# --- Admin ---
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-in-production
SESSION_TTL_HOURS=12

LOG_LEVEL=info
